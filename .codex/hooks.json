{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise run --silent --skip-tools --deny-net codex:hook:workflow-state",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "mise run --silent --skip-tools --deny-net codex:hook:subagent-context",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
